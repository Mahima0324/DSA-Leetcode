class Solution {

    public boolean circularArrayLoop(int[] nums) {
        int n = nums.length;

        for (int i = 0; i < n; i++) {

            if (nums[i] == 0)
                continue;

            boolean forward = nums[i] > 0;

            int slow = i;
            int fast = i;

            while (true) {
                slow = nextIndex(nums, forward, slow);
                if (slow == -1)
                    break;

                fast = nextIndex(nums, forward, fast);
                if (fast == -1)
                    break;

                fast = nextIndex(nums, forward, fast);
                if (fast == -1)
                    break;

                if (slow == fast)
                    return true;
            }

            int curr = i;
            while (true) {
                int next = nextIndex(nums, forward, curr);
                if (next == -1)
                    break;

                nums[curr] = 0;
                curr = next;
            }
            nums[curr] = 0;
        }

        return false;
    }

    private int nextIndex(int[] nums, boolean forward, int curr) {
        boolean direction = nums[curr] > 0;

        if (direction != forward)
            return -1;

        int n = nums.length;
        int next = ((curr + nums[curr]) % n + n) % n;

        // self-loop is invalid
        if (next == curr)
            return -1;

        return next;
    }
}
