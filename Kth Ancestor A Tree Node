class TreeAncestor {
    private int[][] up;   // Binary lifting table
    private int LOG;      // Max power of 2
    private int n;

    public TreeAncestor(int n, int[] parent) {
        this.n = n;
        LOG = 1;
        while ((1 << LOG) <= n) LOG++;  // Calculate max depth for binary lifting
        up = new int[n][LOG];

        // Initialize with direct parent
        for (int v = 0; v < n; v++) {
            up[v][0] = parent[v];
        }

        // Fill binary lifting table
        for (int j = 1; j < LOG; j++) {
            for (int v = 0; v < n; v++) {
                int mid = up[v][j - 1];
                up[v][j] = (mid == -1 ? -1 : up[mid][j - 1]);
            }
        }
    }

    public int getKthAncestor(int node, int k) {
        for (int j = 0; j < LOG; j++) {
            if (((k >> j) & 1) == 1) {
                node = up[node][j];
                if (node == -1) return -1;
            }
        }
        return node;
    }
}
