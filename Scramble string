import java.util.HashMap;
import java.util.Map;

class Solution {
    // Memoization map to store results of subproblems
    // Key: string representation of "i,j,k", Value: boolean result
    private Map<String, Boolean> memo;

    public boolean isScramble(String s1, String s2) {
        if (s1.length() != s2.length()) return false;
        memo = new HashMap<>();
        return solve(s1, s2);
    }

    private boolean solve(String s1, String s2) {
        // Base cases
        if (s1.equals(s2)) return true;
        if (s1.length() <= 1) return false;

        // Pruning optimization: If they don't have the exact same characters, they can't be scrambles
        if (!hasSameCharacters(s1, s2)) return false;

        String key = s1 + "_" + s2;
        if (memo.containsKey(key)) {
            return memo.get(key);
        }

        int n = s1.length();
        // Try all possible split points
        for (int i = 1; i < n; i++) {
            // Case 1: No swap (left matches left, right matches right)
            boolean notSwapped = (solve(s1.substring(0, i), s2.substring(0, i)) && 
                                  solve(s1.substring(i), s2.substring(i)));
            if (notSwapped) {
                memo.put(key, true);
                return true;
            }

            // Case 2: Swapped (left matches right, right matches left)
            boolean swapped = (solve(s1.substring(0, i), s2.substring(n - i)) && 
                               solve(s1.substring(i), s2.substring(0, n - i)));
            if (swapped) {
                memo.put(key, true);
                return true;
            }
        }

        memo.put(key, false);
        return false;
    }

    // Quick character frequency check to prune invalid branches early
    private boolean hasSameCharacters(String s1, String s2) {
        if (s1.length() != s2.length()) return false;
        int[] count = new int[26];
        for (int i = 0; i < s1.length(); i++) {
            count[s1.charAt(i) - 'a']++;
            count[s2.charAt(i) - 'a']--;
        }
        for (int c : count) {
            if (c != 0) return false;
        }
        return true;
    }
}
